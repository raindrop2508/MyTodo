<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg_light"
    android:paddingStart="@dimen/page_horizontal_padding"
    android:paddingTop="@dimen/page_top_padding"
    android:paddingEnd="@dimen/page_horizontal_padding">

    <TextView
        android:id="@+id/tv_tasks_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tasks_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/page_title_size"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_tasks_filter"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_dropdown"
        app:tint="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_tasks_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_tasks_title" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_tasks_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/card_bg_white"
        app:boxCornerRadiusBottomEnd="@dimen/search_bar_radius"
        app:boxCornerRadiusBottomStart="@dimen/search_bar_radius"
        app:boxCornerRadiusTopEnd="@dimen/search_bar_radius"
        app:boxCornerRadiusTopStart="@dimen/search_bar_radius"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tasks_title"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_tasks_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tasks_search_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/body_medium_size" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_tasks_search">

        <TextView
            android:id="@+id/tab_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="按类别"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/body_medium_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_quadrant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="按象限"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_medium_size" />

        <TextView
            android:id="@+id/tab_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="按状态"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_medium_size" />
    </LinearLayout>

    <View
        android:id="@+id/tab_indicator"
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@color/brand_primary"
        app:layout_constraintEnd_toEndOf="@id/layout_tabs"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toStartOf="@id/layout_tabs"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs" />

    <HorizontalScrollView
        android:id="@+id/hsv_category_filters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_indicator">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.MyPotato.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="全部" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_study"
                style="@style/Widget.MyPotato.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="学习   1" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_work"
                style="@style/Widget.MyPotato.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="工作   2" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_life"
                style="@style/Widget.MyPotato.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="生活" />
                
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_health"
                style="@style/Widget.MyPotato.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="健康   1" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tasks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_category_filters"
        tools:listitem="@layout/item_today_task" />

    <LinearLayout
        android:id="@+id/layout_tasks_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_tasks"
        app:layout_constraintEnd_toEndOf="@id/rv_tasks"
        app:layout_constraintStart_toStartOf="@id/rv_tasks"
        app:layout_constraintTop_toTopOf="@id/rv_tasks">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_calendar"
            app:tint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/tasks_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_title_size"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tasks_empty_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_medium_size" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/page_horizontal_padding"
        android:layout_marginBottom="@dimen/fab_margin"
        android:contentDescription="@string/tasks_fab_add_task"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/brand_fab_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/text_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>